rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploads and deletes pass through the authenticated, quota-enforcing API.
    match /portfolio/{nailistId}/{fileName} { allow read: if true; }
    match /avatars/{userId}/{fileName} { allow read: if true; }
    match /covers/{nailistId}/{fileName} { allow read: if true; }
    // Feedback attachments are private; only the admin server can read them.
    match /{allPaths=**} { allow write: if false; }
  }
}
