# Firebase Client SDK (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side, keep secret)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar sync (OAuth 2.0 client — separate from the Maps API key
# below; create under APIs & Services > Credentials, with the Calendar API
# enabled and this app's /api/auth/google-calendar/callback as an authorized
# redirect URI)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional — defaults to `${NEXT_PUBLIC_APP_URL}/api/auth/google-calendar/callback`
GOOGLE_CALENDAR_REDIRECT_URI=

# Sentry (error monitoring + session replay)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=
# Only needed at build time to upload source maps (CI/Railway) — safe to leave empty locally
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
